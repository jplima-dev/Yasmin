# Drive2 core
DRIVE2_HOST=0.0.0.0
DRIVE2_PORT=8000
DRIVE2_STORAGE_ROOT=data/files
DRIVE2_DATABASE=drive2.db
DRIVE2_TEMP_ROOT=data/temp
DRIVE2_TRASH_ROOT=data/trash
DRIVE2_EMAILS_ROOT=data/emails
DRIVE2_ATTACHMENTS_ROOT=data/attachments
DRIVE2_LOG_LEVEL=INFO
DRIVE2_MAX_UPLOAD_MB=1024
DRIVE2_SCAN_INTERVAL_SECONDS=60
DRIVE2_SYNC_INTERVAL_SECONDS=15
DRIVE2_SYNC_MAX_RETRIES=8
# Bloqueia acesso direto pela LAN; permite localhost + IPs Tailscale oficiais.
DRIVE2_TAILSCALE_ONLY=true

# Autenticação (recomendado quando o servidor estiver acessível por mais pessoas na tailnet)
DRIVE2_AUTH_ENABLED=false
DRIVE2_AUTH_USERNAME=admin
# Gere com: python -m app.auth.password
DRIVE2_AUTH_PASSWORD_HASH=
# Gere, por exemplo, com: python -c "import secrets; print(secrets.token_urlsafe(48))"
DRIVE2_AUTH_SECRET=
# Use true apenas se estiver servindo por HTTPS.
DRIVE2_AUTH_COOKIE_SECURE=false
DRIVE2_AUTH_SESSION_HOURS=24

# Cloudflare R2
R2_ENABLED=false
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=EXEMPLO_ACCESS_KEY
R2_SECRET_ACCESS_KEY=EXEMPLO_SECRET_KEY
R2_BUCKET=drive2-backup
R2_ENDPOINT=https://00000000000000000000000000000000.r2.cloudflarestorage.com
R2_REGION=auto
R2_PREFIX=drive2

# Gmail
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=config/gmail_credentials.json
GMAIL_TOKEN_PATH=config/gmail_token.json
GMAIL_ARCHIVE_AFTER_DAYS=30
# Evita carregar e-mails gigantes inteiros na RAM do tablet.
GMAIL_MAX_MESSAGE_MB=50
GMAIL_PROTECT_STARRED=true
GMAIL_PROTECT_IMPORTANT=true
# Só move para a lixeira se o .eml + anexos tiverem backup R2 validado.
GMAIL_TRASH_AFTER_BACKUP=false
